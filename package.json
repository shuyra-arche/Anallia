{
  "name": "shuyra-field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "check": "node --max-old-space-size=384 node_modules/typescript/bin/tsc --noEmit",
    "test": "node tools/test.mjs",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "build:pages": "npm run build -- --base=/Anallia/",
    "test:browser": "node tools/browser-test.mjs",
    "content:generate": "node tools/content-manifest.mjs",
    "content:check": "node tools/content-manifest.mjs --check",
    "predev": "npm run content:generate",
    "precheck": "npm run content:check",
    "pretest": "npm run content:check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "pixi.js": "^8.22.0"
  }
}
